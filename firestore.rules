rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Projeto temporário sem login administrativo.
    // ATENÇÃO: quem descobrir a configuração do Firebase também poderá acessar estes dados.

    match /confirmations/{confirmationId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'childName', 'responsibleName', 'status', 'confirmedAt', 'createdAt'
        ]) &&
        request.resource.data.childName is string &&
        request.resource.data.childName.size() >= 2 &&
        request.resource.data.childName.size() <= 120 &&
        request.resource.data.responsibleName is string &&
        request.resource.data.responsibleName.size() >= 2 &&
        request.resource.data.responsibleName.size() <= 120 &&
        request.resource.data.status == 'confirmed';

      // Necessário para o painel sem login abrir, alterar e excluir confirmações.
      allow read, update, delete: if true;
    }

    match /guests/{guestId} {
      allow read, create, update, delete: if true;
    }
  }
}
