rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /confirmations/{confirmationId} {
      // A página pública só pode ENVIAR uma confirmação.
      allow create: if
        request.resource.data.keys().hasOnly([
          'childName', 'responsibleName', 'status', 'confirmedAt', 'createdAt'
        ]) &&
        request.resource.data.childName is string &&
        request.resource.data.childName.size() >= 2 &&
        request.resource.data.childName.size() <= 120 &&
        request.resource.data.responsibleName is string &&
        request.resource.data.responsibleName.size() >= 2 &&
        request.resource.data.responsibleName.size() <= 120 &&
        request.resource.data.status == 'confirmed';

      // Só o administrador autenticado pode consultar, alterar ou excluir.
      allow read, update, delete: if isSignedIn();
    }

    match /guests/{guestId} {
      // Lista de convidados fica totalmente privada.
      allow read, create, update, delete: if isSignedIn();
    }
  }
}
